pragma language_version 0.28;
import CompactStandardLibrary;

export circuit checkTime(cutoff: Uint<64>, enabled: Boolean): [Boolean, Boolean, Boolean, Boolean] {
  if (disclose(enabled)) {
    return [blockTimeLt(disclose(cutoff)),
            blockTimeGt(disclose(cutoff)),
            blockTimeGte(disclose(cutoff)),
            blockTimeLte(disclose(cutoff))];
  }
  return [false, false, false, false];
}
