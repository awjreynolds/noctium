pragma language_version 0.28;
import CompactStandardLibrary;

export ledger deepSets: Map<Bytes<32>, Map<Bytes<32>, Map<Bytes<32>, Map<Bytes<32>, Map<Bytes<32>, Set<QualifiedShieldedCoinInfo>>>>>>;
export ledger paddingSlot: QualifiedShieldedCoinInfo;

circuit destination(isContract: Boolean, bytes: Bytes<32>): Either<ZswapCoinPublicKey, ContractAddress> {
  return isContract ? right<ZswapCoinPublicKey, ContractAddress>(ContractAddress{bytes: bytes})
                    : left<ZswapCoinPublicKey, ContractAddress>(ZswapCoinPublicKey{bytes: bytes});
}

export circuit initializePath(first: Bytes<32>, second: Bytes<32>, third: Bytes<32>,
                              fourth: Bytes<32>, fifth: Bytes<32>): [] {
  if (!deepSets.member(disclose(first))) { deepSets.insertDefault(disclose(first)); }
  if (!deepSets.lookup(disclose(first)).member(disclose(second))) {
    deepSets.lookup(disclose(first)).insertDefault(disclose(second));
  }
  if (!deepSets.lookup(disclose(first)).lookup(disclose(second)).member(disclose(third))) {
    deepSets.lookup(disclose(first)).lookup(disclose(second)).insertDefault(disclose(third));
  }
  if (!deepSets.lookup(disclose(first)).lookup(disclose(second)).lookup(disclose(third))
      .member(disclose(fourth))) {
    deepSets.lookup(disclose(first)).lookup(disclose(second)).lookup(disclose(third))
      .insertDefault(disclose(fourth));
  }
  if (!deepSets.lookup(disclose(first)).lookup(disclose(second)).lookup(disclose(third))
      .lookup(disclose(fourth)).member(disclose(fifth))) {
    deepSets.lookup(disclose(first)).lookup(disclose(second)).lookup(disclose(third))
      .lookup(disclose(fourth)).insertDefault(disclose(fifth));
  }
}

export circuit insertBookedCoin(first: Bytes<32>, second: Bytes<32>, third: Bytes<32>,
                                fourth: Bytes<32>, fifth: Bytes<32>, domain: Bytes<32>,
                                nonce: Bytes<32>, value: Uint<64>, book: Boolean,
                                bookingIsContract: Boolean, bookingAddress: Bytes<32>,
                                prefixMint: Boolean, paddingNonce: Bytes<32>,
                                paddingValue: Uint<64>): ShieldedCoinInfo {
  if (disclose(prefixMint)) {
    const padding = mintShieldedToken(disclose(domain), disclose(paddingValue),
      disclose(paddingNonce), right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
    paddingSlot.writeCoin(disclose(padding),
      right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  }
  const coin = disclose(book)
    ? mintShieldedToken(disclose(domain), disclose(value), disclose(nonce),
                       disclose(destination(bookingIsContract, bookingAddress)))
    : ShieldedCoinInfo{nonce: nonce, color: tokenType(domain, kernel.self()), value: value};
  deepSets.lookup(disclose(first)).lookup(disclose(second)).lookup(disclose(third))
    .lookup(disclose(fourth)).lookup(disclose(fifth)).insertCoin(
      disclose(coin), right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  return disclose(coin);
}
