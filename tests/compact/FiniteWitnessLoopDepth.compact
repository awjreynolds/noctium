pragma language_version >= 0.28;
import CompactStandardLibrary;

witness visitValue(index: Uint<8>): Field;

circuit witnessLoop<#COUNT>(): Field {
  for (const index of 0..COUNT) {
    const value = visitValue(index as Uint<8>);
    assert(value == (0 as Field), "witness value must be zero");
  }
  return 0 as Field;
}

export circuit witnessLoop16(): Field {
  return witnessLoop<16>();
}

export circuit witnessLoop32(): Field {
  return witnessLoop<32>();
}
