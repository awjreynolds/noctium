pragma language_version 0.28;
import CompactStandardLibrary;

export circuit defaults(): [Bytes<0>, Bytes<4>, Bytes<32>] {
  return [default<Bytes<0>>, default<Bytes<4>>, default<Bytes<32>>];
}

export circuit readableDefaults(): [Field, Boolean, Uint<8>, Bytes<0>, Bytes<3>,
                                     Bytes<32>, Vector<2, Uint<8>>, Vector<0, Uint<8>>] {
  return [default<Field>, default<Boolean>, default<Uint<8>>, default<Bytes<0>>,
          default<Bytes<3>>, default<Bytes<32>>, default<Vector<2, Uint<8>>>,
          default<Vector<0, Uint<8>>>];
}
