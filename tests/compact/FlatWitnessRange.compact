pragma language_version >= 0.28;

witness visit(index: Field): [];

circuit visits<#COUNT>(): Field {
  for (const index of 0..COUNT) {
    visit(index as Field);
  }
  return 0 as Field;
}

export circuit shortRange(): Field {
  return visits<3>();
}

export circuit longRange(): Field {
  return visits<1025>();
}

export circuit aliasRange(): Field {
  for (const index of 0..1200) {
    const localIndex = index as Field;
    visit(localIndex);
  }
  return 0 as Field;
}
