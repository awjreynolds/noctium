pragma language_version 0.28;
import CompactStandardLibrary;

export pure circuit arithmetic(
  k1Base: Secp256k1Base,
  k1Scalar: Secp256k1Scalar,
  r1Base: Secp256r1Base,
  r1Scalar: Secp256r1Scalar,
  c255Base: Curve25519Base,
  c255Scalar: Curve25519Scalar,
  k1BaseZero: Secp256k1Base,
  k1ScalarZero: Secp256k1Scalar,
  r1BaseZero: Secp256r1Base,
  r1ScalarZero: Secp256r1Scalar,
  c255BaseZero: Curve25519Base,
  c255ScalarZero: Curve25519Scalar,
  k1BaseBoundary: Secp256k1Base,
  k1ScalarBoundary: Secp256k1Scalar,
  r1BaseBoundary: Secp256r1Base,
  r1ScalarBoundary: Secp256r1Scalar,
  c255BaseBoundary: Curve25519Base,
  c255ScalarBoundary: Curve25519Scalar
): [
  Secp256k1Base, Secp256k1Base,
  Secp256k1Scalar, Secp256k1Scalar,
  Secp256r1Base, Secp256r1Base,
  Secp256r1Scalar, Secp256r1Scalar,
  Curve25519Base, Curve25519Base,
  Curve25519Scalar, Curve25519Scalar,
  Secp256k1Base, Secp256k1Scalar,
  Secp256r1Base, Secp256r1Scalar,
  Curve25519Base, Curve25519Scalar,
  Secp256k1Base, Secp256k1Base,
  Secp256k1Scalar, Secp256k1Scalar,
  Secp256r1Base, Secp256r1Base,
  Secp256r1Scalar, Secp256r1Scalar,
  Curve25519Base, Curve25519Base,
  Curve25519Scalar, Curve25519Scalar
] {
  return [
    neg(k1Base), inv(k1Base),
    neg(k1Scalar), inv(k1Scalar),
    neg(r1Base), inv(r1Base),
    neg(r1Scalar), inv(r1Scalar),
    neg(c255Base), inv(c255Base),
    neg(c255Scalar), inv(c255Scalar),
    neg(k1BaseZero), neg(k1ScalarZero),
    neg(r1BaseZero), neg(r1ScalarZero),
    neg(c255BaseZero), neg(c255ScalarZero),
    neg(k1BaseBoundary), inv(k1BaseBoundary),
    neg(k1ScalarBoundary), inv(k1ScalarBoundary),
    neg(r1BaseBoundary), inv(r1BaseBoundary),
    neg(r1ScalarBoundary), inv(r1ScalarBoundary),
    neg(c255BaseBoundary), inv(c255BaseBoundary),
    neg(c255ScalarBoundary), inv(c255ScalarBoundary)
  ];
}

export pure circuit inverseZeroK1Base(value: Secp256k1Base): Secp256k1Base {
  return inv(value);
}

export pure circuit inverseZeroK1Scalar(value: Secp256k1Scalar): Secp256k1Scalar {
  return inv(value);
}

export pure circuit inverseZeroR1Base(value: Secp256r1Base): Secp256r1Base {
  return inv(value);
}

export pure circuit inverseZeroR1Scalar(value: Secp256r1Scalar): Secp256r1Scalar {
  return inv(value);
}

export pure circuit inverseZeroC255Base(value: Curve25519Base): Curve25519Base {
  return inv(value);
}

export pure circuit inverseZeroC255Scalar(value: Curve25519Scalar): Curve25519Scalar {
  return inv(value);
}
