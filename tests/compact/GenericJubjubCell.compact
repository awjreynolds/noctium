pragma language_version 0.28;
import CompactStandardLibrary;

module GenericValue<T> {
  export ledger value: T;

  export circuit read(): T {
    return value;
  }

  export circuit update(next: T): [] {
    value = disclose(next);
    return [];
  }
}

import GenericValue<JubjubScalar> prefix explicit_;
import GenericValue<JubjubPoint> prefix point_;

export {
  explicit_value,
  explicit_read,
  explicit_update,
  point_value,
  point_read,
  point_update,
};

constructor(initial: JubjubScalar, initialPoint: JubjubPoint) {
  explicit_value = disclose(initial);
  point_value = disclose(initialPoint);
}

export circuit readExplicit(): JubjubScalar {
  return explicit_read();
}

export circuit updateExplicit(next: JubjubScalar): JubjubScalar {
  explicit_update(disclose(next));
  return explicit_read();
}

export circuit readPoint(): JubjubPoint {
  return point_read();
}

export circuit updatePoint(next: JubjubPoint): JubjubPoint {
  point_update(disclose(next));
  return point_read();
}
