pragma language_version >= 0.28;
import CompactStandardLibrary;

struct Ledger {
  issued: Field;
  spent: Field;
  tag: Bytes<4>;
}

module GenericCell<T> {
  export ledger value: T;

  export circuit inspect(): T {
    return value;
  }

  export circuit update(enabled: Boolean, next: T): T {
    if (disclose(enabled)) {
      value = disclose(next);
    }
    return value;
  }
}

import GenericCell<Ledger> prefix cell_;
export {cell_value};

constructor(initialTag: Bytes<4>) {
  cell_value = disclose(Ledger {
    issued: 5 as Field,
    spent: 42 as Field,
    tag: disclose(initialTag),
  });
}

export circuit inspect(): Ledger {
  return cell_inspect();
}

export circuit update(enabled: Boolean, nextIssued: Field, nextSpent: Field,
                      nextTag: Bytes<4>): Ledger {
  const next = Ledger {
    issued: disclose(nextIssued),
    spent: disclose(nextSpent),
    tag: disclose(nextTag),
  };
  return cell_update(disclose(enabled), next);
}
