pragma language_version 0.28;
import CompactStandardLibrary;

struct Receipt {
  amount: Field;
  active: Boolean;
}

struct Key {
  active: Boolean;
  epoch: Uint<16>;
}

module GenericMap<K, V> {
  export ledger values: Map<K, V>;

  export circuit put(enabled: Boolean, key: K, next: V): [] {
    if (disclose(enabled)) {
      values.insert(disclose(key), disclose(next));
    }
    return [];
  }

  export circuit lookup(key: K): V {
    return values.lookup(disclose(key));
  }
}

import GenericMap<Field, Receipt> prefix fieldReceiptMap_;
import GenericMap<Bytes<32>, Receipt> prefix byteReceiptMap_;
import GenericMap<Key, Uint<16>> prefix recordKeyMap_;
import GenericMap<Key, Receipt> prefix recordKeyReceiptMap_;
export {
  fieldReceiptMap_values, fieldReceiptMap_put, fieldReceiptMap_lookup,
  byteReceiptMap_values, byteReceiptMap_put, byteReceiptMap_lookup,
  recordKeyMap_values, recordKeyMap_put, recordKeyMap_lookup,
  recordKeyReceiptMap_values, recordKeyReceiptMap_put, recordKeyReceiptMap_lookup,
};

export circuit put(enabled: Boolean, key: Field, next: Receipt): [] {
  return fieldReceiptMap_put(disclose(enabled), disclose(key), disclose(next));
}

export circuit lookup(key: Field): Receipt {
  return fieldReceiptMap_lookup(disclose(key));
}

export circuit putBytes(enabled: Boolean, key: Bytes<32>, next: Receipt): [] {
  return byteReceiptMap_put(disclose(enabled), disclose(key), disclose(next));
}

export circuit lookupBytes(key: Bytes<32>): Receipt {
  return byteReceiptMap_lookup(disclose(key));
}

export circuit putRecordKey(enabled: Boolean, key: Key, next: Uint<16>): [] {
  return recordKeyMap_put(disclose(enabled), disclose(key), disclose(next));
}

export circuit lookupRecordKey(key: Key): Uint<16> {
  return recordKeyMap_lookup(disclose(key));
}

export circuit putRecordKeyReceipt(enabled: Boolean, key: Key, next: Receipt): [] {
  return recordKeyReceiptMap_put(disclose(enabled), disclose(key), disclose(next));
}

export circuit lookupRecordKeyReceipt(key: Key): Receipt {
  return recordKeyReceiptMap_lookup(disclose(key));
}
