pragma language_version >= 0.28.0;
import CompactStandardLibrary;

struct Extra {
  enabled: Boolean;
}

struct Payload {
  amount: Field;
  extra: Extra;
}

witness loadLeft(): Payload;
witness loadRight(): Payload;
witness afterChoice(expected: Field): [];

export circuit branchChoice(choice: Boolean, expected: Field): [Field, Boolean] {
  if (choice) {
    const selected = loadLeft();
    assert(selected.amount == expected, "left amount must match expected");
    assert(selected.extra.enabled, "left payload must be enabled");
  } else {
    const selected = loadRight();
    assert(selected.amount == expected, "right amount must match expected");
    assert(!selected.extra.enabled, "right payload must be disabled");
  }
  const completed = afterChoice(expected);
  return [expected, choice];
}

export circuit branchShadowing(choice: Boolean, expected: Field): [Field, Boolean] {
  const outerX = expected;
  const x = expected;
  if (choice) {
    const selected = loadLeft();
    const branchInput = outerX;
    const x = branchInput + 1;
    assert(x == expected + 1, "then binding must use the outer value");
    assert(selected.amount == expected, "left amount must match expected");
    assert(selected.extra.enabled, "left payload must be enabled");
  } else {
    const selected = loadRight();
    const { amount: x } = selected;
    assert(x == expected + 1, "pattern binding must match the selected amount");
    assert(!selected.extra.enabled, "right payload must be disabled");
  }
  const completed = afterChoice(expected);
  return [x, choice];
}

export circuit branches(thenCondition: Boolean, elseCondition: Boolean, amount: Uint<8>): [Boolean, Boolean, Uint<8>] {
  return [
    thenCondition ? ((amount as Uint<1>) == 1) : true,
    elseCondition ? true : ((amount as Uint<1>) == 1),
    thenCondition ? (amount as Uint<1>) : amount
  ];
}

export circuit valueChoice(choice: Boolean, expected: Field): [Field, Boolean] {
  const selected = choice ? loadLeft() : loadRight();
  assert(selected.amount == expected, "selected amount must match expected");
  assert(selected.extra.enabled == choice, "selected flag must match the branch");
  return [disclose(selected.amount), disclose(selected.extra.enabled)];
}
