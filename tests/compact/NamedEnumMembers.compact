pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export enum RecipientKind {
  ShieldedUser,
  UnshieldedUser,
  Contract
}

export pure circuit describe(choice: RecipientKind): [Boolean, RecipientKind] {
  return [choice == RecipientKind.Contract, RecipientKind.Contract];
}

module LeftKinds {
  export enum RecipientKind { ShieldedUser, UnshieldedUser, Contract }
}

module RightKinds {
  export enum RecipientKind { ShieldedUser, UnshieldedUser, Contract }
}

import {RecipientKind as LeftRecipientKind} from LeftKinds;
import {RecipientKind as RightRecipientKind} from RightKinds;

export pure circuit compareSameNamedEnums(
  left: LeftRecipientKind,
  right: RightRecipientKind
): Boolean {
  return left == right;
}

export pure circuit castSameNamedEnum(value: LeftRecipientKind): RightRecipientKind {
  return value as RightRecipientKind;
}
