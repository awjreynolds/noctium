pragma language_version >= 0.28;
import CompactStandardLibrary;

export circuit checkGate(allowed: Boolean): [] {
  return assert(allowed, "gate denied");
}

export circuit checkNestedGate(enabled: Boolean, allowed: Boolean): Field {
  if (enabled) {
    const checked = assert(allowed, "nested gate denied");
    const unitAlias = checked;
  }
  return (enabled ? 7 : 9) as Field;
}
