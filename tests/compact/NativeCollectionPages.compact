pragma language_version 0.28;
import CompactStandardLibrary;

export ledger flags: Map<Field, Boolean>;
export ledger members: Set<Bytes<32>>;
export ledger values: List<Field>;
export ledger nestedFlags: Map<Bytes<32>, Map<Field, Boolean>>;
export ledger nestedMembers: Map<Bytes<32>, Set<Bytes<32>>>;
export ledger nestedValues: Map<Bytes<32>, List<Field>>;

struct Ciphertext4 {
  c1x: Field;
  c1y: Field;
  c2x: Field;
  c2y: Field;
}

struct RecordMemo {
  active: Boolean;
  amount: Uint<16>;
}

export ledger records: Map<Bytes<32>, Ciphertext4>;
export ledger recordList: List<Ciphertext4>;
export ledger recordMembers: Set<RecordMemo>;
export ledger recordFlags: Map<RecordMemo, Uint<16>>;

export circuit putRecordFlag(active: Boolean, amount: Uint<16>, value: Uint<16>): [] {
  const key = disclose(RecordMemo{active: disclose(active), amount: disclose(amount)});
  recordFlags.insert(key, disclose(value));
}

export circuit updateRecordMember(active: Boolean, amount: Uint<16>, adding: Boolean,
                                  removing: Boolean): [Boolean, Uint<64>] {
  const memo = disclose(RecordMemo{active: disclose(active), amount: disclose(amount)});
  if (disclose(adding)) { recordMembers.insert(memo); }
  if (disclose(removing)) { recordMembers.remove(memo); }
  return [recordMembers.member(memo), recordMembers.size()];
}

export circuit seedRecords(key: Bytes<32>, mapped: Ciphertext4, listed: Ciphertext4): [] {
  records.insert(disclose(key), disclose(mapped));
  recordList.pushFront(disclose(listed));
}

export circuit put(key: Field, value: Boolean): [] {
  flags.insert(disclose(key), disclose(value));
}

export circuit add(tag: Bytes<32>): [] {
  members.insert(disclose(tag));
}

export circuit remove(tag: Bytes<32>): [] {
  members.remove(disclose(tag));
}

export circuit prepend(value: Field): [] {
  values.pushFront(disclose(value));
}

export circuit putNested(owner: Bytes<32>, key: Field, value: Boolean): [] {
  const path = disclose(owner);
  if (!nestedFlags.member(path)) { nestedFlags.insertDefault(path); }
  nestedFlags.lookup(path).insert(disclose(key), disclose(value));
}

export circuit addNested(owner: Bytes<32>, tag: Bytes<32>): [] {
  const path = disclose(owner);
  if (!nestedMembers.member(path)) { nestedMembers.insertDefault(path); }
  nestedMembers.lookup(path).insert(disclose(tag));
}

export circuit prependNested(owner: Bytes<32>, value: Field): [] {
  const path = disclose(owner);
  if (!nestedValues.member(path)) { nestedValues.insertDefault(path); }
  nestedValues.lookup(path).pushFront(disclose(value));
}
