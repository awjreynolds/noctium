pragma language_version 0.28;
import CompactStandardLibrary;

export struct Key {
  tag: Bytes<1>;
  id: Bytes<33>;
}

export struct Profile {
  label: Bytes<1>;
  digest: Bytes<33>;
}

export ledger profiles: Map<Bytes<32>, Map<Key, Profile>>;

export circuit store(
  owner: Bytes<32>, tag: Bytes<1>, id: Bytes<33>,
  label: Bytes<1>, digest: Bytes<33>,
): [] {
  const ownerKey = disclose(owner);
  if (!profiles.member(ownerKey)) { profiles.insertDefault(ownerKey); }
  const key = Key { tag: disclose(tag), id: disclose(id) };
  const value = disclose(Profile { label, digest });
  profiles.lookup(ownerKey).insert(key, value);
}

export circuit lookup(
  owner: Bytes<32>, tag: Bytes<1>, id: Bytes<33>,
): [Bytes<1>, Bytes<33>] {
  const ownerKey = disclose(owner);
  const key = Key { tag: disclose(tag), id: disclose(id) };
  const value = profiles.lookup(ownerKey).lookup(key);
  return [value.label, value.digest];
}

export circuit remove(
  owner: Bytes<32>, tag: Bytes<1>, id: Bytes<33>,
): [] {
  const ownerKey = disclose(owner);
  const key = Key { tag: disclose(tag), id: disclose(id) };
  profiles.lookup(ownerKey).remove(key);
}
