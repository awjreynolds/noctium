pragma language_version 0.28;
import CompactStandardLibrary;

struct Inner {
  first: Uint<16>;
  active: Boolean;
}

struct Envelope {
  memo: Inner;
  tag: Field;
}

struct NativeInner {
  first: Field;
  active: Boolean;
}

struct NativeEnvelope {
  memo: NativeInner;
  tag: Field;
}

export ledger records: List<Envelope>;
export ledger nativeRecords: List<NativeEnvelope>;

export circuit push(envelope: Envelope): [] {
  records.pushFront(disclose(envelope));
}

export circuit head(): Maybe<Envelope> {
  return records.head();
}

export circuit pop(): [] {
  records.popFront();
}

export circuit pushNative(envelope: NativeEnvelope): [] {
  nativeRecords.pushFront(disclose(envelope));
}

export circuit headNative(): Maybe<NativeEnvelope> {
  return nativeRecords.head();
}

export circuit popNative(): [] {
  nativeRecords.popFront();
}
