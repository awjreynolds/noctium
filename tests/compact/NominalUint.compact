pragma language_version 0.28;
import CompactStandardLibrary;

export new type Amount = Uint<8>;

export ledger balance: Amount;
export ledger amounts: List<Amount>;

constructor(initial: Amount) {
  balance = disclose(initial);
  amounts.pushFront(disclose(initial));
}

pure circuit forwardAmount(value: Amount): Amount {
  return value;
}

export circuit setAmount(value: Amount): [] {
  balance = disclose(forwardAmount(value));
  amounts.pushFront(disclose(value));
  return [];
}

export circuit setRaw(value: Uint<8>): [] {
  const amount = value as Amount;
  balance = disclose(forwardAmount(amount));
  amounts.pushFront(disclose(amount));
  return [];
}

export circuit amountHead(): Maybe<Amount> {
  return amounts.head();
}

export circuit get(): Amount {
  return forwardAmount(balance);
}

export pure circuit addAmount(left: Amount, right: Amount): Amount {
  const sum: Amount = left + right;
  return sum;
}

export pure circuit toUnderlying(value: Amount): Uint<8> {
  return value as Uint<8>;
}

export pure circuit toAmount(value: Uint<16>): Amount {
  return value as Amount;
}
