pragma language_version >= 0.28;
import CompactStandardLibrary;

module GenericOpaqueIdentity<T> {
  export circuit identity(value: T): T {
    return value;
  }
}

import GenericOpaqueIdentity<Opaque<"string">> prefix string_;
import GenericOpaqueIdentity<Opaque<"Uint8Array">> prefix bytes_;

export {string_identity, bytes_identity};
