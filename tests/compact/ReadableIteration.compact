pragma language_version >= 0.28;
import CompactStandardLibrary;

export ledger total: Field;
witness iterationSeed(): Field;
witness iterationBytes(): Bytes<2>;
witness iterationVisit(item: Uint<8>): Field;
witness pairLeftItems(): Vector<2, Field>;
witness pairRightItems(): Vector<2, Field>;
witness pairVisit(left: Field, right: Field): Field;
witness emptyTupleItems(): [];
witness emptyMapVisit(item: Field): Field;
witness acceptEmptyNativeVector(values: Vector<0, Field>): Field;
witness blockItems(seed: Field): Vector<2, Uint<8>>;
witness blockOffset(seed: Field): Field;

export circuit update(offset: Field): Field {
  const sum = fold((acc, value) => (acc + value) + offset,
    iterationSeed(),
    map((item) => iterationVisit(item), iterationBytes()));
  total = disclose(sum);
  return disclose(sum);
}

export circuit runPairMap(): Field {
  const mapped = map((left, right) => pairVisit(left, right), pairLeftItems(), pairRightItems());
  return disclose(fold((acc, value) => acc + value, 0 as Field, mapped));
}

export circuit runBlock(seed: Field): [Field, Field, Field] {
  const items = blockItems(seed);
  const offset = blockOffset(seed + 1);
  const mapped = map((item) => {
    const widened = item as Field;
    const adjusted = widened + offset;
    assert(adjusted != (999 as Field), "map assertion");
    return adjusted;
  }, items);
  const sum = fold((acc, value) => {
    const next = acc + value;
    assert(next != (85 as Field), "fold assertion");
    return next;
  }, 0 as Field, mapped);
  return [disclose(mapped[0]), disclose(mapped[1]), disclose(sum)];
}

export circuit emptyNativeMap(): Field {
  const mapped = map((item) => {
    const copy = item;
    const copyAgain = copy;
    return true ? copyAgain : copyAgain;
  }, emptyTupleItems());
  const forwarded = mapped;
  return disclose(acceptEmptyNativeVector(forwarded));
}

// No consumer supplies the result type. Keep a typed Field sibling in each
// branch position to match the Lean inference cases.
export circuit emptyNativeMapSiblingElse(chooseItem: Boolean): Boolean {
  const mapped = map((item) => chooseItem ? item : (0 as Field), emptyTupleItems());
  return mapped == [];
}

export circuit emptyNativeMapSiblingThen(chooseItem: Boolean): Boolean {
  const mapped = map((item) => chooseItem ? (0 as Field) : item, emptyTupleItems());
  return mapped == [];
}

export circuit emptyNativeMapUnresolvedBranches(chooseItem: Boolean): Boolean {
  const mapped = map((item) => chooseItem ? item : item, emptyTupleItems());
  return mapped == [];
}

// Keep a host witness in the callback so the runtime comparator proves the
// zero-length map evaluates its source but never invokes its callback.
export circuit emptyNativeMapCallback(chooseItem: Boolean): Boolean {
  const mapped = map((item) => chooseItem
    ? emptyMapVisit(item)
    : emptyMapVisit(item), emptyTupleItems());
  return mapped == [];
}

export circuit emptyNativeMapDeclaredContext(): Vector<0, Field> {
  return map((item) => true ? item : item, emptyTupleItems());
}
