pragma language_version >= 0.28;
import CompactStandardLibrary;

struct Reading {
  reading: Field;
  count: Uint<8>;
  active: Boolean;
}

struct Envelope {
  payload: Reading;
  epoch: Field;
}

pure circuit raiseReading(value: Reading, active: Boolean): Reading {
  return Reading {
    reading: value.reading + 1,
    count: value.count,
    active: active,
  };
}

witness observeActive(value: Field): Boolean;
witness observeCount(value: Field): Uint<8>;
witness observeReading(value: Field): Field;
witness loadBase(value: Field): Reading;
witness loadPair(marker: Field): [Field, Boolean];
witness loadVector(marker: Field): Vector<2, Uint<8>>;
witness loadBytes(marker: Field): Bytes<2>;
witness loadUnit(marker: Field): [];

circuit observe<T>(marker: Field): T {
  return observeCount(marker) as T;
}

export circuit build(seed: Field): Reading {
  return disclose(Reading {
    active: observeActive(seed + 1),
    count: observeCount(seed + 2),
    reading: observeReading(seed + 3),
  });
}

export circuit patch(seed: Field): Reading {
  const partial = Reading {
    ...loadBase(seed),
    active: observeActive(seed + 1),
    count: observeCount(seed + 2),
  };
  const replaced = Reading {
    ...loadBase(seed + 3), active: false, count: 1, reading: seed,
  };
  assert(replaced.reading == seed, "explicit reading must override the spread");
  const wrapped = Envelope { payload: partial, epoch: 0 as Field };
  const patched = Envelope { ...wrapped, epoch: seed };
  return disclose(patched.payload);
}

export circuit spreadTuple(seed: Field): [[Field, Field, Boolean], [Uint<8>, Uint<8>, Uint<8>, Uint<8>], [Boolean, Uint<0..2>]] {
  const headFields = [seed, ...loadPair(seed + 1)];
  const octets = [...loadVector(seed + 2), ...loadBytes(seed + 3)];
  return disclose([headFields, octets, ...loadUnit(seed + 4), ...[], [true, 1]]);
}

export circuit packOctets(seed: Field): Bytes<6> {
  const packed = [7, ...loadVector(seed + 2), ...loadBytes(seed + 3), ...loadUnit(seed + 4), ...[], 23] as Bytes<6>;
  return disclose([packed[5], packed[4], packed[3], packed[2], packed[1], packed[0]] as Bytes<6>);
}

export circuit sliceSequences(seed: Field): [[Boolean], Vector<1, Uint<8>>, [], Bytes<1>] {
  return disclose([
    slice<1>(loadPair(seed + 1), 1),
    slice<1>(loadVector(seed + 2), 1),
    slice<0>(loadPair(seed + 3), 2),
    slice<1>(loadBytes(seed + 4), 1),
  ]);
}

export circuit constructVectors(seed: Field): [Vector<3, Uint<8>>, Vector<3, Uint<16>>, Vector<0, Uint<8>>] {
  const values = loadVector(seed + 2);
  const narrow = [5 as Uint<8>, ...values];
  const wide = [5 as Uint<8>, ...values] as Vector<3, Uint<16>>;
  const empty = [...loadUnit(seed + 4)] as Vector<0, Uint<8>>;
  return disclose([narrow, wide, empty]);
}

export circuit helperRewrite(seed: Field): Reading {
  return disclose(raiseReading(loadBase(seed), observeActive(seed + 1)));
}

export circuit helperProject(seed: Field): Field {
  const changed = raiseReading(loadBase(seed), true);
  return disclose(changed.reading);
}

export circuit genericCount(seed: Field): Uint<16> {
  const small = observe<Uint<8>>(seed);
  const large = observe<Uint<16>>(seed + 1);
  return disclose(((small as Uint<16>) + large) as Uint<16>);
}
