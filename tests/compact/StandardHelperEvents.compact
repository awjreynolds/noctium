pragma language_version 0.28;
import CompactStandardLibrary;

circuit emitSpend(nullifier: Bytes<32>): [] {
  emit(ShieldedSpend { nullifier: disclose(nullifier) });
}

export circuit logHelperSpend(active: Boolean, nullifier: Bytes<32>): [] {
  emit(Paused {});
  if (disclose(active)) {
    emitSpend(nullifier);
  }
  emit(Unpaused {});
}

export circuit logGuardedPause(active: Boolean): [] {
  if (disclose(active)) {
    emit(Paused {});
    emit(Unpaused {});
  }
}
